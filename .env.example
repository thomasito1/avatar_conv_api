# Server-side only — never shipped to the browser.
# Either provide a ready-made Kaltura Session token…
KALTURA_KS=

# …or let the proxy mint an admin KS itself via session.start:
KALTURA_PARTNER_ID=
KALTURA_ADMIN_SECRET=

# Kaltura region for the VOD Avatar Studio API. One of: nvp1 (US East, default),
# irp2 (EU West), frp2 (EU Central), cap2 (Canada), sgp2 (Singapore), syp2 (Australia).
KALTURA_REGION=nvp1

# Port for the local API proxy (vite dev server proxies /api here).
PORT=8787
